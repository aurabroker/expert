# Skopiuj do .env (lokalny dev) oraz ustaw w Cloudflare Pages → Settings → Environment variables.

# Klucz API Resend (https://resend.com/api-keys) — wymagany do wysyłki formularza.
RESEND_API_KEY=

# Adres, na który trafiają zgłoszenia z formularza kontaktowego.
CONTACT_TO_EMAIL=zarzad@auraexpert.pl

# Nadawca wiadomości (domena musi być zweryfikowana w Resend).
CONTACT_FROM_EMAIL=Aura Expert <formularz@auraexpert.pl>

# Sekret Cloudflare Turnstile (antyspam formularza). Puste = weryfikacja pominięta (lokalny dev).
# Klucz witryny jest publiczny i siedzi w src/lib/data/content.js (site.turnstileSiteKey).
TURNSTILE_SECRET_KEY=

# Google Analytics 4 ustawiasz w src/lib/data/content.js (site.gaId) —
# jako stała build-time, dzięki czemu strona główna pozostaje w pełni statyczna.
